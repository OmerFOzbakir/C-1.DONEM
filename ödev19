#include <stdio.h>

int ebob(int x, int y) {
    if (x == y)
        return x;
    if (x > y)
        return ebob(x - y, y);
    return ebob(x, y - x);
}

int ekok(int x, int y) {
    return (x * y) / ebob(x, y);
}

int main() {
    int sayi1, sayi2;

    printf("Lutfen 1. Sayiyi Giriniz: ");
    scanf("%d", &sayi1);
    printf("Lutfen 2. Sayiyi Giriniz: ");
    scanf("%d", &sayi2);

    while (sayi1 <= 0 || sayi2 <= 0) {
        printf("Lutfen 0'dan buyuk sayilar giriniz.\n");
        printf("1. Sayi: "); scanf("%d", &sayi1);
        printf("2. Sayi: "); scanf("%d", &sayi2);
    }

    printf("\nSonuclar:\n");
    printf("EBOB(%d, %d) = %d\n", sayi1, sayi2, ebob(sayi1, sayi2));
    printf("EKOK(%d, %d) = %d\n", sayi1, sayi2, ekok(sayi1, sayi2));

    return 0;
}
