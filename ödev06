#include <stdio.h>
#include <math.h>

int main() {
    int i, sayi, teksayi = 0, ciftsayi = 0;
    double geometrik = 0, carpim = 1;
    float aritmatikToplam = 0, aritmatikOrtalama = 0;

    for (i = 1; i <= 10; i++) {
        printf("%d. sayiyi giriniz: ", i);
        scanf("%d", &sayi);

        if (sayi % 2 == 0) {
            carpim *= sayi;
            ciftsayi++;
        } else {
            aritmatikToplam += sayi;
            teksayi++;
        }
    }

    if (ciftsayi > 0) {
        geometrik = pow(carpim, 1.0 / ciftsayi);
        printf("\nGeometrik Ortalama (Cift Sayilar): %.2lf\n", geometrik);
    } else {
        printf("\nCift sayi girilmedigi icin geometrik ortalama hesaplanamadi.\n");
    }

    if (teksayi > 0) {
        aritmatikOrtalama = aritmatikToplam / teksayi;
        printf("Aritmetik Ortalama (Tek Sayilar): %.2f\n", aritmatikOrtalama);
    } else {
        printf("Tek sayi girilmedigi icin aritmetik ortalama hesaplanamadi.\n");
    }

    return 0;
}
