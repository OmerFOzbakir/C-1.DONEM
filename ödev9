#include <stdio.h>
#include <string.h>

int main() {
    char cumle[100];
    int sayac = 0;
    int i;

    printf("Lutfen bir cumle giriniz: ");
    fgets(cumle, sizeof(cumle), stdin);

    for (i = 0; i < strlen(cumle); i++) {
        if ((i == 0 || cumle[i - 1] == ' ') && cumle[i] != ' ' && cumle[i] != '\n') {
            sayac++;
        }
    }

    printf("%d tane kelime var!\n", sayac);

    return 0;
}
